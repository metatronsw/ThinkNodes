  "graphics": {
    "glow": 4,
    "selection": 4,
    "box": "rounded",
    "line": "straight",
    "lineArc": 0.04,
    "roundedWires": true,
    "junction": "ellipse",
    "junctionSize": 10,
    "lineScale": {
      "straight": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      },
      "sCurve": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      },
      "zigzag": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      },
      "lightning": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      },
      "arc": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      },
      "rope": {
        "plain": 1.2,
        "thick": 0.9,
        "dashed": 1.1,
        "dotted": 1.0
      }
    },
    "motionSpeed": 1,
    "grid": "dots",
    "frame": {
      "width": 2.6,
      "color": "fill",
      "fillOpacity": 0.12
    },
    "sketch": {
      "roughness": 1.3,
      "passes": 1
    },
    "paper": {
      "grid": "sticky",
      "text": "notebook",
      "sheet": "#fbfaf4",
      "ink": "#25314d",
      "rule": "#a9c8e8",
      "margin": "#e58a8f"
    },
    "fonts": [
      "'Chalkboard SE', 'Comic Sans MS', cursive",
      "'Marker Felt', 'Chalkboard SE', cursive",
      "'Bradley Hand', 'Segoe Print', cursive"
    ],
    "textures": {
      "size": 192,
      "images": {
        "paper": "WhiteBoard.paper.webp",
        "cardboard": "WhiteBoard.cardboard.webp"
      },
      "canvas": {
        "light": {
          "image": "paper",
          "opacity": 0.45
        },
        "dark": {
          "image": "cardboard",
          "opacity": 0.2
        }
      },
      "paper": {
        "image": "paper",
        "opacity": 0.4
      }
    }
  }
