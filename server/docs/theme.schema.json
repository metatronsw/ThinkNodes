{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "modes",
    "palettes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "light",
          "dark"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "palettes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colors"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "light": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "light"
                  ]
                },
                {
                  "required": [
                    "dark"
                  ]
                }
              ]
            },
            "minItems": 16,
            "maxItems": 64
          }
        },
        "additionalProperties": false
      }
    },
    "graphics": {
      "type": "object",
      "required": [],
      "properties": {
        "box": {
          "enum": [
            "rounded",
            "rectangle",
            "ellipse",
            "diamond",
            "triangle",
            "pentagon",
            "hexagon",
            "parallelogram"
          ]
        },
        "boxChamfer": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "junction": {
          "enum": [
            "ellipse",
            "rectangle",
            "diamond"
          ]
        },
        "line": {
          "enum": [
            "straight",
            "sCurve",
            "zigzag",
            "lightning",
            "arc",
            "rope"
          ]
        },
        "roundedWires": {
          "type": "boolean"
        },
        "lineArc": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "contour": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 32
        },
        "linePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "grid": {
          "enum": [
            "lines",
            "dots",
            "drafting"
          ]
        },
        "glass": {
          "type": "boolean"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "selection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "junctionSize": {
          "type": "number",
          "minimum": 4,
          "maximum": 128
        },
        "motionSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "lineScale": {
          "type": "object",
          "description": "Vonalvastagság-szorzó vonaltípusonként: egy szám, vagy megjelenésenként (plain, thick, dashed, dotted) külön szám.",
          "propertyNames": {
            "enum": [
              "straight",
              "sCurve",
              "zigzag",
              "lightning",
              "arc",
              "rope"
            ]
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              },
              {
                "type": "object",
                "properties": {
                  "plain": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  },
                  "thick": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  },
                  "dashed": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  },
                  "dotted": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "boxRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "effects": {
          "enum": [
            "liquid"
          ]
        },
        "frame": {
          "type": "object",
          "description": "A doboz kerete: vastagság, szín (fill = a doboz saját színe), a kitöltött felület átlátszatlansága, fényudvar.",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 16
            },
            "color": {
              "enum": [
                "auto",
                "fill"
              ]
            },
            "fillOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "halo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "sketch": {
          "type": "object",
          "description": "Szabadkézi (filc) rajz: a remegés mértéke és a körvonal húzásainak száma.",
          "properties": {
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "additionalProperties": false
        },
        "paper": {
          "type": "object",
          "description": "Papírfelületek: táblázat és CSV cetli, szöveg- és kódfájl füzetlap; a lap, a tinta, a sorvonal és a margó színe.",
          "properties": {
            "grid": {
              "enum": [
                "sticky",
                "plain"
              ]
            },
            "text": {
              "enum": [
                "notebook",
                "plain"
              ]
            },
            "sheet": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "ink": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "rule": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "margin": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
