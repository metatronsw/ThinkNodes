[Unit]
Description=ThinkNodes collaboration server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=thinknodes
Group=thinknodes
WorkingDirectory=/opt/ThinkNodes
Environment=HOME=/var/lib/thinknodes
Environment=THINKNODES_DATA=/var/lib/thinknodes/Projects
Environment=THINKNODES_TLS_DIR=/var/lib/thinknodes/tls
ExecStart=/opt/ThinkNodes/run.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# The service runs without root while retaining permission to bind HTTPS port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# The launcher updates and builds inside the checkout; project data and TLS
# material are kept separately under /var/lib/thinknodes.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ThinkNodes /var/lib/thinknodes
PrivateTmp=true

[Install]
WantedBy=multi-user.target
