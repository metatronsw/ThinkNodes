{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "modes",
    "palettes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "light",
          "dark"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "palettes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colors"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "light": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "light"
                  ]
                },
                {
                  "required": [
                    "dark"
                  ]
                }
              ]
            },
            "minItems": 8,
            "maxItems": 64
          }
        },
        "additionalProperties": false
      }
    },
    "graphics": {
      "type": "object",
      "required": [],
      "properties": {
        "box": {
          "enum": [
            "rounded",
            "rectangle",
            "ellipse",
            "diamond",
            "triangle",
            "pentagon",
            "hexagon",
            "parallelogram"
          ]
        },
        "junction": {
          "enum": [
            "ellipse",
            "rectangle",
            "diamond"
          ]
        },
        "line": {
          "enum": [
            "straight",
            "sCurve",
            "zigzag",
            "lightning",
            "arc",
            "rope"
          ]
        },
        "contour": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 32
        },
        "linePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "grid": {
          "enum": [
            "lines",
            "dots"
          ]
        },
        "panelRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "selection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "junctionSize": {
          "type": "number",
          "minimum": 4,
          "maximum": 128
        },
        "motionSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "css": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "padding": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "font": {
          "enum": [
            "system",
            "mono",
            "serif"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
